server/migrations/__pycache__/

# IDE settings
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.*

# Distribution archives
*.zip
build/
dist/

# This is a Python-only backend submission.
# No TypeScript files are expected.
# No TSX files are expected.
# Flask development server output
*.pid

# Local editor backups
*~
*.swp
*.swo

# Python tooling metadata
.mypy_cache/
.ruff_cache/

# Local shell history files
.python_history

# Keep submitted source files tracked.
